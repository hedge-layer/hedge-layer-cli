{
  "name": "@hedge-layer/cli",
  "version": "5.0.0",
  "description": "CLI for Hedge Layer — unified financial data and execution",
  "type": "module",
  "bin": {
    "hl": "dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "finance",
    "mcp",
    "polymarket",
    "trading",
    "cli"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hedge-layer/hedge-layer-cli.git"
  },
  "dependencies": {
    "commander": "^13.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.5.2",
    "eslint": "^10.0.3",
    "tsup": "^8.4.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.57.0",
    "vitest": "^4.1.8"
  }
}
